import json
import csv
import os

def export_json(data, output_path):
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)

def export_txt(data, output_path, indent=0):
    with open(output_path, "w", encoding="utf-8") as f:
        _write_txt(data, f, indent)

def _write_txt(data, file, indent):
    for key, value in data.items():
        file.write("  " * indent + f"- {key}\n")
        if isinstance(value, dict):
            _write_txt(value, file, indent + 1)

def export_csv(data, output_path):
    rows = []

    def walk(node, path=""):
        for key, value in node.items():
            current = f"{path}/{key}" if path else key
            rows.append([current])
            if isinstance(value, dict):
                walk(value, current)

    walk(data)

    with open(output_path, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["Path"])
        writer.writerows(rows)


# ------------------------------------------------------------
# Semantic analysis exporters
# ------------------------------------------------------------

def export_semantic_json(results, output_path, global_stats=None, anchor_tokens=None):
    """Export semantic analysis results to JSON with full stats."""
    data = {
        "files": [],
        "corpus": None
    }

    for r in results:
        stats_dict = {}
        for token, stats in r.token_stats.items():
            stats_dict[token] = {
                "count": stats.count,
                "weight": stats.weight,
                "sources": list(stats.sources)
            }
        data["files"].append({
            "file_path": r.file_path,
            "local_tags": r.local_tags,
            "corpus_tags": {
                "content": r.corpus_tags.content,
                "structure": r.corpus_tags.structure,
                "format": r.corpus_tags.format
            },
            "token_stats": stats_dict
        })

    # Add corpus-level info if available
    if global_stats and anchor_tokens:
        corpus_info = {
            "anchor_tokens": sorted(anchor_tokens),
            "global_stats": {}
        }
        for token in anchor_tokens:
            if token in global_stats:
                s = global_stats[token]
                corpus_info["global_stats"][token] = {
                    "file_count": s.file_count,
                    "total_count": s.total_count,
                    "total_weight": s.total_weight,
                    "sources": list(s.sources)
                }
        data["corpus"] = corpus_info

    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)


def export_semantic_csv(results, output_path):
    """Export semantic analysis results to CSV (stratified tags)."""
    with open(output_path, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["File", "Local Tags", "Corpus Content", "Corpus Structure", "Corpus Format"])
        for r in results:
            writer.writerow([
                r.file_path,
                "; ".join(r.local_tags),
                "; ".join(r.corpus_tags.content),
                "; ".join(r.corpus_tags.structure),
                "; ".join(r.corpus_tags.format)
            ])


def export_semantic_txt(results, output_path, anchor_tokens=None):
    """Export semantic analysis results to human-readable TXT."""
    with open(output_path, "w", encoding="utf-8") as f:
        # Corpus summary header
        if anchor_tokens:
            f.write("=" * 60 + "\n")
            f.write("CORPUS ANCHORS\n")
            f.write("=" * 60 + "\n")
            f.write(", ".join(sorted(anchor_tokens)) + "\n")
            f.write("=" * 60 + "\n\n")

        # Per-file results
        for r in results:
            f.write(f"File: {r.file_path}\n")
            f.write(f"Local tags: {', '.join(r.local_tags) if r.local_tags else '(none)'}\n")
            f.write(f"Corpus content: {', '.join(r.corpus_tags.content) if r.corpus_tags.content else '(none)'}\n")
            f.write(f"Corpus structure: {', '.join(r.corpus_tags.structure) if r.corpus_tags.structure else '(none)'}\n")
            f.write(f"Corpus format: {', '.join(r.corpus_tags.format) if r.corpus_tags.format else '(none)'}\n")
            f.write("Token stats:\n")
            for token, stats in sorted(r.token_stats.items(), key=lambda x: x[1].weight, reverse=True):
                sources_str = ', '.join(stats.sources)
                anchor_mark = " [ANCHOR]" if anchor_tokens and token in anchor_tokens else ""
                f.write(f"  {token}: count={stats.count}, weight={stats.weight}, sources=[{sources_str}]{anchor_mark}\n")
            f.write("\n" + "-" * 60 + "\n\n")
