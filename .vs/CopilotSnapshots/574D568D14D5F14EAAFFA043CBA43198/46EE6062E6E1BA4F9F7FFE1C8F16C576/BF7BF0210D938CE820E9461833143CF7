from ui_ascii import (
    banner,
    ask_path_safe,
    ask_include_files,
    ask_include_subfolders,
    ask_output_format,
    ask_next_action,
    ask_template_from_list,
    ask_semantic_output_format,
)
from scanner import scan_folder
from exporters import (
    export_json,
    export_csv,
    export_txt,
    export_semantic_json,
    export_semantic_csv,
    export_semantic_txt,
)
from utils import make_safe_filename, get_date_stamp
from template_parser import parse_fst
from folder_creator import create_folders
from semantic_analyzer import analyze_corpus
import os

OUTPUT_DIR = "output"
PREFIX = "folder_"

def ask_mode():
    """Prompt user to select the main program mode."""
    print("\nSelect mode:")
    print("1) Parse existing folder")
    print("2) Create folders from template (.fst)")
    print("3) Semantic analyze files")
    print("4) Exit")
    return input("> ").strip()

def run_parse_mode():
    """Run folder parsing and export mode."""
    root_path = ask_path_safe()
    if not root_path:
        print("\n[INFO] Exiting program.")
        return

    include_files = ask_include_files()
    include_subfolders = ask_include_subfolders()
    output_format = ask_output_format()

    root_name = os.path.basename(root_path.rstrip("\\/"))
    print("\n[INFO] Root directory:")
    print(root_path)
    print(f"[INFO] Root folder name: {root_name}")

    tree = scan_folder(root_path, include_files, include_subfolders)

    safe_root = make_safe_filename(root_name)
    date_stamp = get_date_stamp()

    output_filename = f"{PREFIX}{safe_root}_{date_stamp}.{output_format}"
    output_file = os.path.join(OUTPUT_DIR, output_filename)

    os.makedirs(OUTPUT_DIR, exist_ok=True)

    # Export the folder structure in the selected format
    if output_format == "json":
        export_json({root_name: tree}, output_file)
    elif output_format == "csv":
        export_csv({root_name: tree}, output_file)
    else:
        export_txt({root_name: tree}, output_file)

    print("\n[OK] Parsing completed")
    print("[INFO] Output saved to:")
    print(output_file)

def run_template_mode():
    """Run folder creation from template mode."""
    template_path = ask_template_from_list()
    if not template_path:
        return

    template_name = os.path.splitext(os.path.basename(template_path))[0]
    output_root = os.path.join("output", f"template_{template_name}")

    try:
        structure = parse_fst(template_path)
    except Exception as e:
        print(f"\n[ERROR] Invalid .fst file:")
        print(e)
        return

    create_folders(output_root, structure)

    print("\n[OK] Folder structure created")
    print("[INFO] Output location:")
    print(output_root)


def run_semantic_mode():
    """Run semantic analysis mode on files in a folder."""
    root_path = ask_path_safe()
    if not root_path:
        print("\n[INFO] Exiting program.")
        return

    output_format = ask_semantic_output_format()

    # Collect all file paths recursively
    file_paths = []
    for root, dirs, files in os.walk(root_path):
        for f in files:
            file_paths.append(os.path.join(root, f))

    if not file_paths:
        print("\n[INFO] No files found in the folder.")
        return

    print(f"\n[INFO] Analyzing {len(file_paths)} files...")

    # Run semantic analysis
    results = analyze_files(file_paths)

    # Prepare output
    root_name = os.path.basename(root_path.rstrip("\\/"))
    safe_root = make_safe_filename(root_name)
    date_stamp = get_date_stamp()

    output_filename = f"semantic_{safe_root}_{date_stamp}.{output_format}"
    output_file = os.path.join(OUTPUT_DIR, output_filename)

    os.makedirs(OUTPUT_DIR, exist_ok=True)

    # Export results
    if output_format == "json":
        export_semantic_json(results, output_file)
    elif output_format == "csv":
        export_semantic_csv(results, output_file)
    else:
        export_semantic_txt(results, output_file)

    # Summary stats
    files_with_tags = sum(1 for r in results if r.tags)
    total_tags = sum(len(r.tags) for r in results)

    print("\n[OK] Semantic analysis completed")
    print(f"[INFO] Files analyzed: {len(results)}")
    print(f"[INFO] Files with tags: {files_with_tags}")
    print(f"[INFO] Total tags found: {total_tags}")
    print("[INFO] Output saved to:")
    print(output_file)

def main():
    """Main program loop."""
    while True:
        banner()
        mode = ask_mode()

        if mode == "1":
            action = run_parse_mode
        elif mode == "2":
            action = run_template_mode
        elif mode == "3":
            action = run_semantic_mode
        else:
            print("\n[INFO] Exiting program.")
            return

        # Run selected mode once
        action()

        while True:
            next_action = ask_next_action()

            if next_action == "1":
                break  # back to main menu
            elif next_action == "2":
                action()  # repeat same mode
            else:
                print("\n[INFO] Program finished.")
                return

if __name__ == "__main__":
    main()
