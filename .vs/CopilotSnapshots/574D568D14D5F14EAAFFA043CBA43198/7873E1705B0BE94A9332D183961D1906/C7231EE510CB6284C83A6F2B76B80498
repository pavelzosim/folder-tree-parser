"""
Semantic analyzer module.

Extracts tags from file system structure based on token repetition.
NO stopwords, NO dictionaries, NO interpretation - only explicit repetitions.

Algorithm:
1. Tokenize full path (split by space, _, -, .)
2. Local: tokens appearing 2+ times in the path -> candidate tags
3. Corpus: tokens appearing in 2+ files -> added to tags
4. Weight: based on local + corpus frequency
5. Root folder preserved as base collection tag
"""

import os
import re
from dataclasses import dataclass, field
from typing import Dict, List, Set, Tuple, Optional
from collections import Counter

from semantic_config import SemanticConfig, DEFAULT_CONFIG


@dataclass
class FileTagResult:
    """Result of tag extraction for a single file."""
    file_path: str
    tags: List[Tuple[str, float]]  # (token, weight) sorted by weight desc
    token_counts: Dict[str, int]   # raw token counts for debugging
    
    @property
    def tag_names(self) -> List[str]:
        """Just the tag names without weights."""
        return [tag for tag, _ in self.tags]


@dataclass 
class CorpusStats:
    """Global statistics across the corpus."""
    file_count: Dict[str, int] = field(default_factory=dict)  # token -> number of files
    total_count: Dict[str, int] = field(default_factory=dict)  # token -> total occurrences
    root_folder: str = ""  # root folder name (base tag)


def tokenize_path(full_path: str, config: SemanticConfig = DEFAULT_CONFIG) -> List[str]:
    """
    Tokenize a full path into normalized tokens.

    Split by: space, _, -, .
    Normalize: lowercase, strip, remove empty/punctuation-only

    Args:
        full_path: Full file path string
        config: Configuration for filtering options

    Returns:
        List of normalized tokens (including extension as token if enabled)
    """
    # Normalize path separators
    normalized = full_path.replace('\\', '/')

    # Split into path segments
    segments = normalized.split('/')

    # Filter out empty segments and drive letters
    segments = [s for s in segments if s and not re.match(r'^[A-Za-z]:$', s)]

    if not segments:
        return []

    tokens = []

    # Process each segment
    for i, segment in enumerate(segments):
        is_filename = (i == len(segments) - 1)

        if is_filename:
            # Extract extension as separate token
            name, ext = os.path.splitext(segment)
            if ext and config.include_extensions:
                tokens.append(ext.lower())  # e.g., ".pdf"
            segment = name

        # Split by delimiters: space, _, -, .
        raw_tokens = re.split(r'[\s_\-\.]+', segment)

        for token in raw_tokens:
            norm = token.lower().strip()

            # Skip empty or punctuation-only tokens
            if not norm or re.match(r'^[^\w]+$', norm):
                continue

            # Skip numeric-only tokens if configured
            if config.exclude_numbers and norm.isdigit():
                continue

            tokens.append(norm)

    return tokens


def get_root_folder(full_path: str) -> str:
    """Extract the root folder name from a path."""
    normalized = full_path.replace('\\', '/')
    segments = normalized.split('/')
    segments = [s for s in segments if s and not re.match(r'^[A-Za-z]:$', s)]
    return segments[0].lower() if segments else ""


def analyze_file_local(
    full_path: str,
    config: SemanticConfig = DEFAULT_CONFIG
) -> Tuple[Dict[str, int], List[str]]:
    """
    Local analysis: find tokens appearing 2+ times in the path.

    Args:
        full_path: Full file path
        config: Configuration for filtering options

    Returns:
        Tuple of (token_counts, local_tags)
        - token_counts: all tokens with their counts
        - local_tags: tokens with count >= 2
    """
    tokens = tokenize_path(full_path, config)
    token_counts = Counter(tokens)

    # Local tags: tokens appearing 2+ times in this path
    local_tags = [token for token, count in token_counts.items() if count >= 2]

    return dict(token_counts), local_tags


def build_corpus_stats(
    file_paths: List[str],
    config: SemanticConfig = DEFAULT_CONFIG
) -> CorpusStats:
    """
    Build corpus-wide statistics.

    Args:
        file_paths: List of all file paths
        config: Configuration for filtering options

    Returns:
        CorpusStats with file_count and total_count per token
    """
    stats = CorpusStats()

    # Determine root folder from first file
    if file_paths:
        stats.root_folder = get_root_folder(file_paths[0])

    for path in file_paths:
        tokens = tokenize_path(path, config)
        unique_tokens = set(tokens)
        token_counts = Counter(tokens)

        # Count files containing each token
        for token in unique_tokens:
            stats.file_count[token] = stats.file_count.get(token, 0) + 1

        # Count total occurrences
        for token, count in token_counts.items():
            stats.total_count[token] = stats.total_count.get(token, 0) + count

    return stats


def calculate_weight(token: str, local_count: int, corpus_stats: CorpusStats) -> float:
    """
    Calculate tag weight based on local and corpus frequency.
    
    Weight = local_count + corpus_file_count
    Higher frequency = higher weight
    
    Args:
        token: The token
        local_count: How many times token appears in this file's path
        corpus_stats: Corpus-wide statistics
        
    Returns:
        Numeric weight
    """
    corpus_file_count = corpus_stats.file_count.get(token, 0)
    
    # Weight formula: local frequency + corpus document frequency
    # This prioritizes tokens that are both locally repeated AND globally common
    weight = local_count + corpus_file_count
    
    return float(weight)


def extract_tags(
    full_path: str,
    corpus_stats: CorpusStats,
    local_counts: Dict[str, int],
    local_tags: List[str],
    config: SemanticConfig = DEFAULT_CONFIG
) -> List[Tuple[str, float]]:
    """
    Extract final tags for a file combining local and corpus signals.

    Tag criteria:
    1. Token appears 2+ times in the path (local), OR
    2. Token appears in min_token_freq+ files in corpus (global)

    Special: root folder is always included as base tag.

    Args:
        full_path: File path
        corpus_stats: Corpus statistics
        local_counts: Token counts for this file
        local_tags: Tokens with local count >= 2
        config: Configuration for filtering options

    Returns:
        List of (token, weight) sorted by weight descending
    """
    tags_set = set(local_tags)

    # Add corpus tags: tokens appearing in min_token_freq+ files
    for token in local_counts:
        if corpus_stats.file_count.get(token, 0) >= config.min_token_freq:
            tags_set.add(token)

    # Always include root folder as base collection tag
    root = get_root_folder(full_path)
    if root and root in local_counts:
        tags_set.add(root)

    # Calculate weights and filter by min_token_weight
    tags_with_weight = []
    for token in tags_set:
        local_count = local_counts.get(token, 0)
        weight = calculate_weight(token, local_count, corpus_stats)
        # Only include tags meeting minimum weight threshold
        if weight >= config.min_token_weight:
            tags_with_weight.append((token, weight))

    # Sort by weight descending
    tags_with_weight.sort(key=lambda x: x[1], reverse=True)

    return tags_with_weight


def analyze_corpus(
    file_paths: List[str],
    config: Optional[SemanticConfig] = None
) -> Tuple[List[FileTagResult], CorpusStats]:
    """
    Main entry point: analyze all files and extract tags.

    Algorithm:
    1. Build corpus statistics (token frequencies across all files)
    2. For each file:
       - Local analysis: find repeated tokens in path
       - Combine with corpus: add tokens appearing in min_token_freq+ files
       - Calculate weights and sort

    Args:
        file_paths: List of full paths to all files
        config: Configuration for analysis (uses DEFAULT_CONFIG if None)

    Returns:
        Tuple of (results, corpus_stats)
        - results: List of FileTagResult for each file
        - corpus_stats: Corpus-wide statistics
    """
    if config is None:
        config = DEFAULT_CONFIG

    # Step 1: Build corpus statistics
    corpus_stats = build_corpus_stats(file_paths, config)

    # Step 2: Analyze each file
    results = []

    for path in file_paths:
        # Local analysis
        local_counts, local_tags = analyze_file_local(path, config)

        # Extract tags (local + corpus)
        tags = extract_tags(path, corpus_stats, local_counts, local_tags, config)

        result = FileTagResult(
            file_path=path,
            tags=tags,
            token_counts=local_counts
        )
        results.append(result)

    return results, corpus_stats


# Backward compatibility
def analyze_files(file_paths: List[str]) -> List[FileTagResult]:
    """Analyze files (backward compatibility)."""
    results, _ = analyze_corpus(file_paths)
    return results
