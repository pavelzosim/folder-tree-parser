"""
Semantic analyzer module.

Builds a set of tags for a file based on repeating tokens in:
- file name
- parent folder names (up the hierarchy)

NO interpretation. NO classification. Only pattern matching by token overlap.
"""

import os
import re
from dataclasses import dataclass, field
from typing import Dict, List, Set


# Weight constants by source proximity to file
WEIGHT_FILENAME = 3.0
WEIGHT_PARENT_N1 = 2.0
WEIGHT_PARENT_N2 = 1.0
WEIGHT_HIGHER = 0.5

# Tag selection thresholds
MIN_COUNT_FOR_TAG = 2
MIN_WEIGHT_FOR_TAG = 3.0

# Minimum token length (excluding extensions)
MIN_TOKEN_LENGTH = 2


@dataclass
class TokenStats:
    """Statistics for a single token."""
    count: int = 0
    weight: float = 0.0
    sources: Set[str] = field(default_factory=set)


@dataclass
class GlobalTokenStats:
    """Global statistics for a token across the corpus."""
    file_count: int = 0           # in how many files this token appears (anywhere)
    folder_file_count: int = 0    # in how many files this token appears in FOLDER path
    total_count: int = 0          # total occurrences across all files
    total_weight: float = 0.0
    sources: Set[str] = field(default_factory=set)  # aggregated sources across corpus
    unique_folder_paths: Set[str] = field(default_factory=set)  # unique folder paths where token appears


@dataclass
class CorpusTags:
    """Stratified corpus tags by origin/form."""
    content: List[str] = field(default_factory=list)    # semantic anchors (folder+file)
    structure: List[str] = field(default_factory=list)  # path structure (folder-only)
    format: List[str] = field(default_factory=list)     # file extensions (.pdf, .epub)


@dataclass
class SemanticResult:
    """Result of semantic analysis for a file."""
    file_path: str
    local_tags: List[str]                                    # from local path analysis
    corpus_tags: CorpusTags = field(default_factory=CorpusTags)  # stratified corpus tags
    token_stats: Dict[str, TokenStats] = field(default_factory=dict)

    @property
    def tags(self) -> List[str]:
        """Combined tags (local + corpus.content) for primary use."""
        combined = list(self.local_tags)
        for t in self.corpus_tags.content:
            if t not in combined:
                combined.append(t)
        return combined

    @property
    def all_corpus_tags(self) -> List[str]:
        """All corpus tags flattened (content + structure + format)."""
        return self.corpus_tags.content + self.corpus_tags.structure + self.corpus_tags.format


def _tokenize_segment(segment: str, is_filename: bool = False) -> List[str]:
    """
    Tokenize a path segment by splitting on space, _, -, .
    
    For filenames, the extension is extracted as a separate token.
    
    Args:
        segment: A single path segment (folder name or filename)
        is_filename: If True, treat as filename and extract extension
        
    Returns:
        List of normalized tokens
    """
    tokens = []
    extension = None
    
    if is_filename:
        # Extract extension as separate token
        name, ext = os.path.splitext(segment)
        if ext:
            extension = ext.lower()  # includes the dot, e.g. ".pdf"
        segment = name
    
    # Split by delimiters: space, _, -, .
    raw_tokens = re.split(r'[\s_\-\.]+', segment)
    
    for token in raw_tokens:
        normalized = token.lower().strip()
        
        # Skip empty tokens
        if not normalized:
            continue
        
        # Skip tokens shorter than MIN_TOKEN_LENGTH (unless it's a number)
        if len(normalized) < MIN_TOKEN_LENGTH and not normalized.isdigit():
            continue
        
        tokens.append(normalized)
    
    # Add extension as a token if present
    if extension:
        tokens.append(extension)
    
    return tokens


def _get_weight_for_depth(depth: int) -> float:
    """
    Get weight based on depth (distance from file).
    
    Args:
        depth: 0 = filename, 1 = parent folder, 2 = grandparent, etc.
        
    Returns:
        Weight value for this depth level
    """
    if depth == 0:
        return WEIGHT_FILENAME
    elif depth == 1:
        return WEIGHT_PARENT_N1
    elif depth == 2:
        return WEIGHT_PARENT_N2
    else:
        return WEIGHT_HIGHER


def _get_source_label(depth: int) -> str:
    """
    Get source label for a given depth.
    
    Args:
        depth: 0 = filename, 1+ = folder levels
        
    Returns:
        Human-readable source label
    """
    if depth == 0:
        return "file"
    else:
        return "folder"


def analyze_file(full_path: str) -> SemanticResult:
    """
    Perform semantic analysis on a file path.
    
    Builds tags based on repeating tokens in the file name
    and parent folder names, weighted by proximity to the file.
    
    Args:
        full_path: Full path to the file
        
    Returns:
        SemanticResult with tags sorted by weight descending
    """
    # Normalize path separators
    normalized_path = full_path.replace('\\', '/')
    
    # Split into segments
    segments = normalized_path.split('/')
    
    # Filter out empty segments and drive letters (e.g., "F:")
    segments = [s for s in segments if s and not re.match(r'^[A-Za-z]:$', s)]
    
    if not segments:
        return SemanticResult(
            file_path=full_path,
            tags=[],
            token_stats={}
        )
    
    # Last segment is the filename, rest are folders
    filename = segments[-1]
    folders = segments[:-1]
    
    # Reverse folders so index 0 is closest to file (parent)
    folders_reversed = list(reversed(folders))
    
    # Build token statistics
    token_stats: Dict[str, TokenStats] = {}
    
    # Process filename (depth = 0)
    filename_tokens = _tokenize_segment(filename, is_filename=True)
    for token in filename_tokens:
        if token not in token_stats:
            token_stats[token] = TokenStats(sources=set())
        token_stats[token].count += 1
        token_stats[token].weight += _get_weight_for_depth(0)
        token_stats[token].sources.add(_get_source_label(0))
    
    # Process folders (depth = 1, 2, 3, ...)
    for folder_index, folder in enumerate(folders_reversed):
        depth = folder_index + 1  # depth 1 = parent, depth 2 = grandparent, etc.
        folder_tokens = _tokenize_segment(folder, is_filename=False)
        
        for token in folder_tokens:
            if token not in token_stats:
                token_stats[token] = TokenStats(sources=set())
            token_stats[token].count += 1
            token_stats[token].weight += _get_weight_for_depth(depth)
            token_stats[token].sources.add(_get_source_label(depth))
    
    # Select tags based on criteria:
    # 1. count >= 2 (token appears in multiple path segments), OR
    # 2. weight >= 3 AND token appears in BOTH file and folder (cross-segment signal)
    # 
    # This ensures filename-only tokens (count=1, sources={"file"}) are NOT tags
    tags_with_weight = []
    for token, stats in token_stats.items():
        has_cross_segment_signal = "file" in stats.sources and "folder" in stats.sources

        if stats.count >= MIN_COUNT_FOR_TAG:
            # Repeated across multiple segments
            tags_with_weight.append((token, stats.weight))
        elif stats.weight >= MIN_WEIGHT_FOR_TAG and has_cross_segment_signal:
            # High weight with cross-segment presence
            tags_with_weight.append((token, stats.weight))
    
    # Sort by weight descending
    tags_with_weight.sort(key=lambda x: x[1], reverse=True)
    
    # Extract just the tag names
    tags = [tag for tag, _ in tags_with_weight]

    return SemanticResult(
        file_path=full_path,
        local_tags=tags,
        corpus_tags=CorpusTags(),
        token_stats=token_stats
    )


def analyze_files(file_paths: List[str]) -> List[SemanticResult]:
    """
    Perform semantic analysis on multiple files.

    Args:
        file_paths: List of full paths to files

    Returns:
        List of SemanticResult objects
    """
    return [analyze_file(path) for path in file_paths]


# ------------------------------------------------------------
# Corpus-level analysis (Level 2)
# ------------------------------------------------------------

# Corpus anchor thresholds
MIN_FILE_COUNT_FOR_ANCHOR = 3
MIN_TOTAL_WEIGHT_FOR_ANCHOR = 10.0


def build_corpus_index(results: List[SemanticResult]) -> Dict[str, GlobalTokenStats]:
    """
    Build a global token index from all file results.

    Args:
        results: List of SemanticResult from local analysis

    Returns:
        Dictionary mapping token -> GlobalTokenStats
    """
    global_stats: Dict[str, GlobalTokenStats] = {}

    for result in results:
        # Track which tokens appear in this file (for file_count)
        seen_in_file: Set[str] = set()
        # Track which tokens appear in folder context for this file
        seen_in_folder_context: Set[str] = set()

        for token, stats in result.token_stats.items():
            if token not in global_stats:
                global_stats[token] = GlobalTokenStats(sources=set())

            global_stats[token].total_count += stats.count
            global_stats[token].total_weight += stats.weight
            global_stats[token].sources.update(stats.sources)

            if token not in seen_in_file:
                global_stats[token].file_count += 1
                seen_in_file.add(token)

            # Count files where this token appears in folder context
            if 'folder' in stats.sources and token not in seen_in_folder_context:
                global_stats[token].folder_file_count += 1
                seen_in_folder_context.add(token)

    return global_stats


def _classify_corpus_token(token: str, global_stats: GlobalTokenStats) -> str:
    """
    Classify a corpus token by its origin/form (NOT by meaning).

    STRICT RULES (Spec v2.1):
    - format: file extensions (starts with '.')
    - structure: folder-only tokens (path hierarchy)
    - content: tokens that appear in BOTH file AND folder contexts across 2+ files
    - noise: everything else (file-only artifacts, single appearances)

    The key insight: content tokens must demonstrate STRUCTURAL REPETITION
    AND cross-segment presence. A token must:
    1. Appear in folders (structural signal)
    2. Appear in files (content signal)  
    3. Appear across multiple files (repetition signal)

    Args:
        token: The token string
        global_stats: Global statistics for this token

    Returns:
        Category string: 'format', 'structure', 'content', or 'noise'
    """
    # File extensions → format
    if token.startswith('.'):
        return 'format'

    sources = global_stats.sources
    has_folder = 'folder' in sources
    has_file = 'file' in sources

    # Only folder sources → structure (path hierarchy tokens)
    # These organize but don't describe content
    if has_folder and not has_file:
        return 'structure'

    # STRICT content criteria:
    # 1. Must appear in BOTH file and folder contexts (cross-segment signal)
    # 2. Must appear in folders of 2+ files (structural repetition)
    if has_folder and has_file and global_stats.folder_file_count >= 2:
        return 'content'

    # File-only tokens → noise (no structural signal)
    return 'noise'


def get_anchor_tokens(global_stats: Dict[str, GlobalTokenStats]) -> Set[str]:
    """
    Identify anchor tokens from the corpus.

    Anchor token criteria:
    - file_count >= 3 (appears in multiple files), OR
    - total_weight >= 10 (strong presence even if fewer files)

    Args:
        global_stats: Global token statistics

    Returns:
        Set of anchor token strings
    """
    anchors = set()

    for token, stats in global_stats.items():
        if stats.file_count >= MIN_FILE_COUNT_FOR_ANCHOR:
            anchors.add(token)
        elif stats.total_weight >= MIN_TOTAL_WEIGHT_FOR_ANCHOR:
            anchors.add(token)

    return anchors


def apply_corpus_tags(
    results: List[SemanticResult],
    anchor_tokens: Set[str],
    global_stats: Dict[str, GlobalTokenStats]
) -> None:
    """
    Apply stratified corpus-level tags to files based on anchor token intersection.

    A file gets a corpus_tag if:
    - token exists in file's token_stats, AND
    - token is a global anchor, AND
    - token is not classified as 'noise'

    Tags are stratified into: content, structure, format

    Modifies results in place.

    Args:
        results: List of SemanticResult to update
        anchor_tokens: Set of anchor tokens from corpus
        global_stats: Global stats for classification and sorting
    """
    for result in results:
        content_tags = []
        structure_tags = []
        format_tags = []

        for token in result.token_stats:
            # Only process anchors that are not already local tags
            if token not in anchor_tokens or token in result.local_tags:
                continue

            category = _classify_corpus_token(token, global_stats[token])
            weight = global_stats[token].total_weight

            if category == 'content':
                content_tags.append((token, weight))
            elif category == 'structure':
                structure_tags.append((token, weight))
            elif category == 'format':
                format_tags.append((token, weight))
            # 'noise' is ignored

        # Sort each category by global weight descending
        content_tags.sort(key=lambda x: x[1], reverse=True)
        structure_tags.sort(key=lambda x: x[1], reverse=True)
        format_tags.sort(key=lambda x: x[1], reverse=True)

        result.corpus_tags = CorpusTags(
            content=[t for t, _ in content_tags],
            structure=[t for t, _ in structure_tags],
            format=[t for t, _ in format_tags]
        )


def analyze_corpus(file_paths: List[str]) -> tuple[List[SemanticResult], Dict[str, GlobalTokenStats], Set[str]]:
    """
    Perform full semantic analysis with corpus-level tagging.

    Two-level analysis:
    1. Local: analyze each file's path for repeating tokens
    2. Corpus: identify anchor tokens and apply to files

    Args:
        file_paths: List of full paths to files

    Returns:
        Tuple of (results, global_stats, anchor_tokens)
    """
    # Level 1: Local analysis
    results = analyze_files(file_paths)

    # Level 2: Corpus analysis
    global_stats = build_corpus_index(results)
    anchor_tokens = get_anchor_tokens(global_stats)
    apply_corpus_tags(results, anchor_tokens, global_stats)

    return results, global_stats, anchor_tokens
