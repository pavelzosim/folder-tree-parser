def ask_semantic_config():
    """Prompt for semantic analysis configuration options.

    Returns:
        dict: Configuration overrides for SemanticConfig
    """
    print("\nConfigure analysis (press Enter for defaults):")

    config_overrides = {}

    # min_token_freq
    val = input("Min files for corpus tag [2]: ").strip()
    if val.isdigit() and int(val) > 0:
        config_overrides["min_token_freq"] = int(val)

    # min_token_weight
    val = input("Min tag weight [2.0]: ").strip()
    try:
        if val:
            config_overrides["min_token_weight"] = float(val)
    except ValueError:
        pass

    # include_extensions
    val = input("Include file extensions as tags? (y/n) [y]: ").strip().lower()
    if val == "n":
        config_overrides["include_extensions"] = False
    elif val == "y":
        config_overrides["include_extensions"] = True

    # exclude_numbers
    val = input("Exclude numeric-only tokens? (y/n) [y]: ").strip().lower()
    if val == "n":
        config_overrides["exclude_numbers"] = False
    elif val == "y":
        config_overrides["exclude_numbers"] = True

    return config_overrides


def ask_obsidian_options():
    """Prompt for Obsidian-specific export options.

    Returns:
        dict: Configuration overrides for Obsidian export
    """
    config_overrides = {}

    print("\nObsidian export options:")

    # max_lines_per_file
    val = input("Max lines per file (0 = no limit) [1000]: ").strip()
    if val.isdigit():
        lines = int(val)
        if lines == 0:
            config_overrides["max_lines_per_file"] = 999999999
        elif lines > 0:
            config_overrides["max_lines_per_file"] = lines

    return config_overrides


