def show_settings_menu(current_settings: dict) -> str:
    """Display settings menu and return user choice.

    Args:
        current_settings: Current semantic settings dict

    Returns:
        User choice string
    """
    s = current_settings

    print("\n" + "=" * 50)
    print("SETTINGS - Semantic Analysis")
    print("=" * 50)
    print(f"1) Min files for corpus tag:    {s.get('min_token_freq', 2)}")
    print(f"2) Min tag weight:              {s.get('min_token_weight', 2.0)}")
    print(f"3) Include extensions:          {'Yes' if s.get('include_extensions', True) else 'No'}")
    print(f"4) Exclude numbers:             {'Yes' if s.get('exclude_numbers', True) else 'No'}")
    print(f"5) Path format (Obsidian):      {s.get('path_format', 'absolute')}")
    print(f"6) Output mode (Obsidian):      {s.get('output_mode', 'content')}")
    print(f"7) Max lines per file:          {s.get('max_lines_per_file', 1000)}")
    print("-" * 50)
    print("8) Reset to defaults")
    print("0) Back to main menu")
    print("-" * 50)

    return input("Select option to change: ").strip()


def edit_setting(key: str, current_value) -> tuple:
    """Prompt user to edit a specific setting.

    Args:
        key: Setting key name
        current_value: Current value

    Returns:
        Tuple of (new_value, changed: bool)
    """
    if key == "min_token_freq":
        print(f"\nCurrent: {current_value}")
        val = input("New value (integer > 0): ").strip()
        if val.isdigit() and int(val) > 0:
            return int(val), True

    elif key == "min_token_weight":
        print(f"\nCurrent: {current_value}")
        val = input("New value (decimal >= 0): ").strip()
        try:
            if val:
                new_val = float(val)
                if new_val >= 0:
                    return new_val, True
        except ValueError:
            pass

    elif key == "include_extensions":
        print(f"\nCurrent: {'Yes' if current_value else 'No'}")
        val = input("Include file extensions as tags? (y/n): ").strip().lower()
        if val in ("y", "n"):
            return val == "y", True

    elif key == "exclude_numbers":
        print(f"\nCurrent: {'Yes' if current_value else 'No'}")
        val = input("Exclude numeric-only tokens? (y/n): ").strip().lower()
        if val in ("y", "n"):
            return val == "y", True

    elif key == "path_format":
        print(f"\nCurrent: {current_value}")
        print("1) absolute")
        print("2) relative")
        val = input("> ").strip()
        if val == "1":
            return "absolute", True
        elif val == "2":
            return "relative", True

    elif key == "output_mode":
        print(f"\nCurrent: {current_value}")
        print("1) content (markdown)")
        print("2) yaml (frontmatter)")
        val = input("> ").strip()
        if val == "1":
            return "content", True
        elif val == "2":
            return "yaml", True

    elif key == "max_lines_per_file":
        print(f"\nCurrent: {current_value}")
        val = input("New value (0 = no limit): ").strip()
        if val.isdigit():
            lines = int(val)
            if lines == 0:
                return 999999999, True
            elif lines > 0:
                return lines, True

    print("[INFO] Value unchanged.")
    return current_value, False
