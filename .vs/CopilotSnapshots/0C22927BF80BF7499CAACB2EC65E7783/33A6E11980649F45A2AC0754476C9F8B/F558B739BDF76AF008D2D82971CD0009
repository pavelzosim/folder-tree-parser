"""
Configuration for semantic analyzer.

Adjustable parameters for tag extraction sensitivity and export options.
"""

from dataclasses import dataclass


@dataclass
class SemanticConfig:
    """Configuration for semantic analysis."""
    
    # Tag filtering
    min_token_freq: int = 2           # Min files where token must appear
    min_token_weight: float = 2.0     # Min weight to become a tag
    include_extensions: bool = True   # Include file extensions as tags
    exclude_numbers: bool = True      # Exclude numeric-only tokens (1984, 2024)
    
    # Obsidian export
    path_format: str = "absolute"     # "absolute" or "relative"
    output_mode: str = "content"      # "content" or "yaml"
    max_lines_per_file: int = 1000    # Split MD if exceeds this


# Default configuration instance
DEFAULT_CONFIG = SemanticConfig()
