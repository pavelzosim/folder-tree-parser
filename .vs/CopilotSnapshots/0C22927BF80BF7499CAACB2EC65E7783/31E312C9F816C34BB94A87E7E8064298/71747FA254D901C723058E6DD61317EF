"""
Settings module.

Persistent storage for user preferences via JSON file.
"""

import json
import os
from typing import Dict, Any

from semantic_config import SemanticConfig


SETTINGS_FILE = "settings.json"

DEFAULT_SETTINGS: Dict[str, Any] = {
    "semantic": {
        "min_token_freq": 2,
        "min_token_weight": 2.0,
        "include_extensions": True,
        "exclude_numbers": True,
        "path_format": "absolute",
        "output_mode": "content",
        "max_lines_per_file": 1000,
    }
}


def load_settings() -> Dict[str, Any]:
    """Load settings from file or return defaults."""
    if os.path.exists(SETTINGS_FILE):
        try:
            with open(SETTINGS_FILE, "r", encoding="utf-8") as f:
                saved = json.load(f)
                # Merge with defaults for forward compatibility
                merged = DEFAULT_SETTINGS.copy()
                for section, values in saved.items():
                    if section in merged:
                        merged[section].update(values)
                    else:
                        merged[section] = values
                return merged
        except (json.JSONDecodeError, IOError):
            pass
    return DEFAULT_SETTINGS.copy()


def save_settings(settings: Dict[str, Any]) -> bool:
    """
    Save settings to file.

    Returns:
        True if saved successfully.
    """
    try:
        with open(SETTINGS_FILE, "w", encoding="utf-8") as f:
            json.dump(settings, f, indent=2, ensure_ascii=False)
        return True
    except IOError:
        return False


def get_semantic_config() -> SemanticConfig:
    """Get SemanticConfig instance from saved settings."""
    settings = load_settings()
    semantic = settings.get("semantic", {})

    # Filter out deprecated keys not in SemanticConfig
    valid_keys = {"min_token_freq", "min_token_weight", "include_extensions", 
                  "exclude_numbers", "max_lines_per_file"}
    filtered = {k: v for k, v in semantic.items() if k in valid_keys}

    return SemanticConfig(**filtered)


def update_semantic_settings(updates: Dict[str, Any]) -> bool:
    """
    Update semantic settings with new values.

    Args:
        updates: Dict of setting key -> value to update.

    Returns:
        True if saved successfully.
    """
    settings = load_settings()
    settings["semantic"].update(updates)
    return save_settings(settings)


def reset_settings() -> bool:
    """
    Reset all settings to defaults.

    Returns:
        True if saved successfully.
    """
    return save_settings(DEFAULT_SETTINGS.copy())
